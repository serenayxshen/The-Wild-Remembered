:root{
    --bg:#1a1f1b;
    --panel:#111613cc;
    --panel2:#1b231fcc;
    --text:#d8e2d3;
    --muted:#99aa95;
    --accent:#7aa68a;
    --warn:#c8a664;
    --danger:#b96a6a;
    --blue:#7fb8d8;
  }
  *{box-sizing:border-box}
  html,body{
    margin:0;
    width:100%;
    height:100%;
    overflow:hidden;
    background:#101310;
    color:var(--text);
    font-family:Verdana, Geneva, Tahoma, sans-serif;
    image-rendering:pixelated;
    touch-action:none;
  }
  #gameWrap{
    position:fixed;
    inset:0;
    background:
      radial-gradient(circle at 20% 20%, #263228 0%, #171d19 45%, #0f1310 100%);
  }
  canvas{
    display:block;
    width:100%;
    height:100%;
  }
  .ui{
    position:fixed;
    inset:0;
    pointer-events:none;
  }
  .topbar{
    position:absolute;
    top:10px;
    left:10px;
    right:10px;
    display:flex;
    gap:10px;
    justify-content:space-between;
    align-items:flex-start;
  }
  .panel{
    background:var(--panel);
    border:2px solid #3b493e;
    border-radius:10px;
    box-shadow:0 0 0 2px #0d100e inset, 0 8px 20px #0008;
    padding:8px;
    pointer-events:auto;
    backdrop-filter:blur(2px);
  }
  .stats{
    width:min(420px,65vw);
  }
  .title{
    font-size:14px;
    letter-spacing:1px;
    color:#dfe9d8;
    margin-bottom:6px;
    text-transform:uppercase;
  }
  .bar{
    margin:6px 0;
  }
  .barlabel{
    display:flex;
    justify-content:space-between;
    font-size:12px;
    color:var(--muted);
    margin-bottom:2px;
  }
  .barbg{
    height:14px;
    background:#243026;
    border:1px solid #4a5a4e;
    border-radius:8px;
    overflow:hidden;
  }
  .fill{
    height:100%;
    transition:width .2s linear;
  }
  .health{background:linear-gradient(90deg,#8f3f45,#d06b72)}
  .stamina{background:linear-gradient(90deg,#466a55,#7ab58e)}
  .hunger{background:linear-gradient(90deg,#8f7a47,#d9c170)}
  .smallText{
    font-size:12px;
    line-height:1.35;
    color:#b6c4b4;
  }
  .rightPanels{
    display:flex;
    flex-direction:column;
    gap:8px;
    width:min(370px,42vw);
  }
  .packList{
    max-height:180px;
    overflow:auto;
  }
  .wolfRow{
    display:grid;
    grid-template-columns:1fr auto;
    gap:8px;
    align-items:center;
    font-size:12px;
    padding:4px 0;
    border-bottom:1px solid #2a352d;
  }
  .wolfRow:last-child{border-bottom:none}
  .wolfMood{color:#9fb2a7}
  .bottomBar{
    position:absolute;
    left:10px;
    right:10px;
    bottom:10px;
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    gap:10px;
  }
  .controlsPanel{
    max-width:min(720px,100%);
  }
  .btns{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    margin-top:6px;
  }
  button{
    pointer-events:auto;
    background:#243027;
    color:#dce7d9;
    border:2px solid #4e6353;
    border-radius:8px;
    padding:8px 10px;
    font-size:12px;
    cursor:pointer;
    min-height:38px;
  }
  button:hover{background:#304035}
  button:active{transform:translateY(1px)}
  .activeBtn{
    background:#4c6757;
    border-color:#98b09f;
  }
  .logPanel{
    width:min(420px,45vw);
  }
  #log{
    font-size:12px;
    color:#c6d2c4;
    max-height:140px;
    overflow:auto;
    line-height:1.35;
  }
  .logLine{margin:2px 0}
  .centerOverlay{
    position:absolute;
    inset:0;
    display:flex;
    justify-content:center;
    align-items:center;
    background:#0b0f0ccc;
    pointer-events:auto;
  }
  .menu{
    width:min(560px,92vw);
    background:linear-gradient(180deg,#182019,#101612);
    border:2px solid #4a5a4d;
    border-radius:14px;
    padding:16px;
    box-shadow:0 20px 50px #000a;
  }
  .menu h1{
    margin:0 0 8px;
    font-size:28px;
    color:#e4efe1;
    letter-spacing:1px;
  }
  .menu p{
    color:#b4c3b1;
    font-size:14px;
    line-height:1.45;
  }
  .menuGrid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
    margin-top:10px;
  }
  .hint{
    position:absolute;
    left:50%;
    transform:translateX(-50%);
    top:10px;
    background:#0f1611cc;
    border:1px solid #425147;
    color:#d9e7d8;
    font-size:12px;
    padding:6px 10px;
    border-radius:20px;
    pointer-events:none;
    opacity:0;
    transition:opacity .25s;
  }
  .showHint{opacity:1}
  #mobilePad{
    position:absolute;
    left:10px;
    bottom:90px;
    width:140px;
    height:140px;
    pointer-events:auto;
    display:none;
  }
  .padBase{
    position:absolute;
    inset:0;
    border-radius:50%;
    background:#182119aa;
    border:2px solid #4b5b4e;
  }
  .padKnob{
    position:absolute;
    width:56px;
    height:56px;
    left:42px;
    top:42px;
    border-radius:50%;
    background:#607a69dd;
    border:2px solid #b9ccb8;
  }
  #mobileActions{
    position:absolute;
    right:10px;
    bottom:90px;
    display:none;
    gap:8px;
    flex-direction:column;
    pointer-events:auto;
  }
  .actionBig{
    width:74px;
    height:50px;
    font-size:12px;
    border-radius:12px;
  }
  @media (max-width: 900px){
    .topbar{flex-direction:column; align-items:stretch}
    .rightPanels,.stats,.logPanel{width:auto; max-width:none}
    .bottomBar{flex-direction:column; align-items:stretch}
    #mobilePad,#mobileActions{display:block}
    .controlsPanel{padding-bottom:54px}
  }
